[Unit]
Description=EnerIQ - FastAPI gateway (red interna de LXCs, no LAN)
After=network-online.target postgresql.service

[Service]
Type=simple
WorkingDirectory=/root/eneriq-app
ExecStart=/root/eneriq-app/.venv/bin/uvicorn main:app --host 0.0.0.0 --port 8091
Restart=on-failure
RestartSec=5

[Install]
WantedBy=multi-user.target
